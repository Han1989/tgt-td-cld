{
  "name": "@tdt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs --external:bufferutil --external:utf-8-validate --log-level=warning",
    "start": "node dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "dependencies": {
    "@tdt/protocol": "0.1.0",
    "@tdt/sim": "0.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2"
  }
}
