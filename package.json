{
  "name": "tower-defense-together",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tdt/client",
    "build": "npm run typecheck && npm run build -w @tdt/client && npm run build -w @tdt/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "npm run preview -w @tdt/client",
    "balance": "tsx packages/sim/scripts/balance.ts",
    "dev:server": "npm run dev -w @tdt/server",
    "loadtest": "npm run build -w @tdt/server && npm run loadtest -w @tdt/server --",
    "map": "tsx packages/sim/scripts/map.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
